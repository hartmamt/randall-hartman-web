{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "680px",
      "wideSize": "1200px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        {
          "slug": "night",
          "name": "Night",
          "color": "#080E11"
        },
        {
          "slug": "ink",
          "name": "Ink",
          "color": "#0A1A1F"
        },
        {
          "slug": "storm",
          "name": "Slate",
          "color": "#343C3E"
        },
        {
          "slug": "text",
          "name": "Text",
          "color": "#172124"
        },
        {
          "slug": "muted",
          "name": "Slate blue",
          "color": "#4A5457"
        },
        {
          "slug": "dust",
          "name": "Stone",
          "color": "#9AA3A4"
        },
        {
          "slug": "parchment",
          "name": "Title white",
          "color": "#F5F1E8"
        },
        {
          "slug": "rule",
          "name": "Rule",
          "color": "#E2D5B8"
        },
        {
          "slug": "paper",
          "name": "Daybreak",
          "color": "#FBF4E4"
        },
        {
          "slug": "paper-deep",
          "name": "Daybreak deep",
          "color": "#F3E7CC"
        },
        {
          "slug": "ember",
          "name": "Orange",
          "color": "#ED8515"
        },
        {
          "slug": "ember-glow",
          "name": "Amber (on dark only)",
          "color": "#E3A237"
        },
        {
          "slug": "accent",
          "name": "Burnt orange (large text only)",
          "color": "#C66019"
        },
        {
          "slug": "ember-text",
          "name": "Rust",
          "color": "#964211"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "serif",
          "name": "EB Garamond",
          "fontFamily": "'EB Garamond', Garamond, Georgia, serif"
        },
        {
          "slug": "sans",
          "name": "Inter",
          "fontFamily": "Inter, ui-sans-serif, system-ui, sans-serif"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "name": "Small",
          "size": "14px",
          "fluid": false
        },
        {
          "slug": "medium",
          "name": "Body",
          "size": "17px",
          "fluid": false
        },
        {
          "slug": "essay",
          "name": "Essay",
          "size": "22px",
          "fluid": {
            "min": "20px",
            "max": "22px"
          }
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "34px",
          "fluid": {
            "min": "26px",
            "max": "34px"
          }
        },
        {
          "slug": "x-large",
          "name": "Extra large",
          "size": "56px",
          "fluid": {
            "min": "36px",
            "max": "56px"
          }
        },
        {
          "slug": "huge",
          "name": "Huge",
          "size": "92px",
          "fluid": {
            "min": "46px",
            "max": "92px"
          }
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "%",
        "vw"
      ],
      "spacingSizes": [
        {
          "slug": "20",
          "name": "2X-Small",
          "size": "8px"
        },
        {
          "slug": "30",
          "name": "X-Small",
          "size": "16px"
        },
        {
          "slug": "40",
          "name": "Small",
          "size": "24px"
        },
        {
          "slug": "50",
          "name": "Medium",
          "size": "clamp(28px, 3vw, 40px)"
        },
        {
          "slug": "60",
          "name": "Large",
          "size": "clamp(40px, 5vw, 64px)"
        },
        {
          "slug": "70",
          "name": "X-Large",
          "size": "clamp(56px, 7vw, 96px)"
        },
        {
          "slug": "80",
          "name": "2X-Large",
          "size": "clamp(80px, 10vw, 140px)"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--paper)",
      "text": "var(--wp--preset--color--text)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--sans)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.6"
    },
    "spacing": {
      "padding": {
        "left": "clamp(16px, 4vw, 40px)",
        "right": "clamp(16px, 4vw, 40px)"
      }
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--serif)",
          "fontWeight": "400",
          "lineHeight": "1.05",
          "letterSpacing": "-0.02em"
        },
        "color": {
          "text": "var(--wp--preset--color--ink)"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--ember-text)"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--ember)",
          "text": "var(--wp--preset--color--ink)"
        },
        "border": {
          "radius": "0"
        },
        "typography": {
          "fontSize": "13px",
          "fontWeight": "600",
          "letterSpacing": "0.08em",
          "textTransform": "uppercase"
        }
      }
    },
    "blocks": {
      "core/post-content": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--serif)",
          "fontSize": "var(--wp--preset--font-size--essay)",
          "lineHeight": "1.7"
        }
      },
      "core/pullquote": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--serif)",
          "fontStyle": "italic"
        }
      }
    }
  }
}