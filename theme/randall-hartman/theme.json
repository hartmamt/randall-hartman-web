{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"custom": false,
			"customGradient": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"duotone": [],
			"gradients": [],
			"palette": [
				{ "slug": "night", "name": "Night", "color": "#061419" },
				{ "slug": "storm", "name": "Storm", "color": "#17262D" },
				{ "slug": "slate", "name": "Slate", "color": "#4E5F69" },
				{ "slug": "ink-soft", "name": "Soft ink (secondary text)", "color": "#22323A" },
				{ "slug": "fog", "name": "Fog", "color": "#C9D0D4" },
				{ "slug": "mist", "name": "Mist", "color": "#E6EAEB" },
				{ "slug": "paper", "name": "Paper", "color": "#F6F7F5" },
				{ "slug": "on-dark-soft", "name": "Soft light (text on dark)", "color": "#CBD3D7" },
				{ "slug": "gold", "name": "Doorway gold", "color": "#F6B90E" },
				{ "slug": "orange", "name": "Path orange", "color": "#E08322" },
				{ "slug": "orange-light", "name": "Path orange, light", "color": "#EB9536" }
			]
		},
		"layout": {
			"contentSize": "680px",
			"wideSize": "1240px"
		},
		"spacing": {
			"units": [ "px", "em", "rem", "vw", "%" ],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "10", "name": "XS", "size": "8px" },
				{ "slug": "20", "name": "S", "size": "16px" },
				{ "slug": "30", "name": "M", "size": "clamp(20px, 2.4vw, 28px)" },
				{ "slug": "40", "name": "L", "size": "clamp(32px, 4vw, 48px)" },
				{ "slug": "50", "name": "XL", "size": "clamp(48px, 6vw, 80px)" },
				{ "slug": "60", "name": "2XL", "size": "clamp(72px, 9vw, 120px)" },
				{ "slug": "70", "name": "Section", "size": "clamp(80px, 10vw, 150px)" }
			]
		},
		"typography": {
			"customFontSize": true,
			"dropCap": false,
			"fluid": true,
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"slug": "serif",
					"name": "EB Garamond",
					"fontFamily": "\"EB Garamond\", Garamond, Georgia, serif",
					"fontFace": [
						{
							"fontFamily": "EB Garamond",
							"fontStyle": "normal",
							"fontWeight": "400 800",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/eb-garamond-variable.woff2" ]
						},
						{
							"fontFamily": "EB Garamond",
							"fontStyle": "italic",
							"fontWeight": "400 800",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/eb-garamond-variable-italic.woff2" ]
						}
					]
				},
				{
					"slug": "sans",
					"name": "Archivo",
					"fontFamily": "Archivo, \"Arial Narrow\", \"Helvetica Neue\", Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Archivo",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontStretch": "62% 125%",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/archivo-variable.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "16px", "fluid": false },
				{ "slug": "medium", "name": "Body", "size": "21px", "fluid": { "min": "20px", "max": "22px" } },
				{ "slug": "large", "name": "Large", "size": "30px", "fluid": { "min": "24px", "max": "34px" } },
				{ "slug": "x-large", "name": "Statement", "size": "28px", "fluid": { "min": "23px", "max": "32px" } },
				{ "slug": "xx-large", "name": "Section heading", "size": "52px", "fluid": { "min": "36px", "max": "64px" } },
				{ "slug": "huge", "name": "Name", "size": "68px", "fluid": { "min": "40px", "max": "80px" } },
				{ "slug": "giant", "name": "Poster", "size": "120px", "fluid": { "min": "44px", "max": "156px" } }
			]
		},
		"blocks": {
			"core/button": {
				"border": { "radius": false }
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--mist)",
			"text": "var(--wp--preset--color--night)"
		},
		"spacing": {
			"blockGap": "24px",
			"padding": {
				"left": "max(16px, 3.2vw)",
				"right": "max(16px, 3.2vw)",
				"top": "0",
				"bottom": "0"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--serif)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": { "text": "currentColor" },
				"typography": { "textDecoration": "underline" }
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontWeight": "500",
					"lineHeight": "1.1",
					"letterSpacing": "-0.015em"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--huge)", "lineHeight": "1.04" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)", "fontWeight": "400", "lineHeight": "1.02" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)", "lineHeight": "1.15" } },
			"h4": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)", "lineHeight": "1.2" } },
			"h5": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)" } },
			"h6": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)" } },
			"button": {
				"color": {
					"background": "var(--wp--preset--color--orange)",
					"text": "var(--wp--preset--color--night)"
				},
				"border": { "radius": "0", "width": "0" },
				"spacing": {
					"padding": { "top": "17px", "bottom": "17px", "left": "26px", "right": "26px" }
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontSize": "17px",
					"fontWeight": "700",
					"lineHeight": "1.1"
				},
				":hover": {
					"color": { "background": "var(--wp--preset--color--orange-light)" }
				},
				":focus": {
					"color": { "background": "var(--wp--preset--color--orange-light)" }
				}
			},
			"caption": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontSize": "15px",
					"fontWeight": "500"
				},
				"color": { "text": "var(--wp--preset--color--ink-soft)" }
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontSize": "25px",
					"fontWeight": "500",
					"lineHeight": "1"
				},
				"elements": {
					"link": { "typography": { "textDecoration": "none" } }
				}
			},
			"core/navigation": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontSize": "17px",
					"fontWeight": "600"
				}
			},
			"core/quote": {
				"border": {
					"left": { "color": "var(--wp--preset--color--orange)", "width": "4px", "style": "solid" }
				},
				"spacing": {
					"padding": { "left": "24px" },
					"margin": { "top": "1.6em", "bottom": "1.6em" }
				},
				"typography": {
					"fontStyle": "italic",
					"fontSize": "1.3em",
					"lineHeight": "1.35"
				},
				"elements": {
					"cite": {
						"typography": {
							"fontFamily": "var(--wp--preset--font-family--sans)",
							"fontSize": "16px",
							"fontStyle": "normal",
							"fontWeight": "700"
						}
					}
				}
			},
			"core/pullquote": {
				"border": { "width": "0" },
				"typography": { "fontStyle": "italic", "fontSize": "var(--wp--preset--font-size--x-large)" }
			},
			"core/post-title": {
				"typography": { "fontWeight": "500" }
			},
			"core/post-date": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontSize": "16px",
					"fontWeight": "500"
				}
			},
			"core/post-terms": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontSize": "15px",
					"fontWeight": "600"
				}
			},
			"core/post-time-to-read": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontSize": "16px",
					"fontWeight": "700"
				},
				"color": { "text": "var(--wp--preset--color--slate)" }
			},
			"core/query-pagination": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontSize": "16px",
					"fontWeight": "600"
				}
			},
			"core/search": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontSize": "16px"
				}
			},
			"core/separator": {
				"color": { "text": "var(--wp--preset--color--fog)" }
			},
			"core/image": {
				"elements": {
					"caption": { "typography": { "textAlign": "left" } }
				}
			}
		}
	},
	"customTemplates": [
		{
			"name": "page-canvas",
			"title": "Full width, no title (for pages built from sections)",
			"postTypes": [ "page" ]
		}
	],
	"templateParts": [
		{ "name": "announcement", "title": "Announcement bar", "area": "uncategorized" },
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
